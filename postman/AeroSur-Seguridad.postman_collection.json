{
  "info": {
    "name": "AeroSur - Tácticas de seguridad",
    "description": "Los cinco pedidos del guion de exposición. Cada uno es un acto discreto cuyo código de respuesta evidencia una táctica. Correr en orden: los logins guardan el token en la variable de colección.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "1 - PUT ruta SIN token -> 401 (autenticar actores)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('401 sin credencial', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"ruta\":\"cinta-7\"}" },
        "url": {
          "raw": "{{baseUrl}}/api/equipaje/123/ruta",
          "host": ["{{baseUrl}}"],
          "path": ["api", "equipaje", "123", "ruta"]
        }
      }
    },
    {
      "name": "2 - Login operador -> 200 + token (autenticar actores)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 con credencial válida', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('token', pm.response.json().token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"usuario\":\"operador\",\"password\":\"1234\"}" },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "login"]
        }
      }
    },
    {
      "name": "3 - PUT ruta con token de OPERADOR -> 403 (autorizar actores)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('403 rol sin permiso', () => pm.response.to.have.status(403));",
              "pm.test('el error nombra el rol del actor', () => pm.expect(pm.response.json().rolDelActor).to.eql('operador'));"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": { "mode": "raw", "raw": "{\"ruta\":\"cinta-7\"}" },
        "url": {
          "raw": "{{baseUrl}}/api/equipaje/123/ruta",
          "host": ["{{baseUrl}}"],
          "path": ["api", "equipaje", "123", "ruta"]
        }
      }
    },
    {
      "name": "4 - Login supervisor -> 200 + token",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 con credencial válida', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('token', pm.response.json().token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"usuario\":\"supervisor\",\"password\":\"1234\"}" },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "login"]
        }
      }
    },
    {
      "name": "5 - PUT ruta con token de SUPERVISOR -> 200 (autorizar actores)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 ruta modificada', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": { "mode": "raw", "raw": "{\"ruta\":\"cinta-7\"}" },
        "url": {
          "raw": "{{baseUrl}}/api/equipaje/123/ruta",
          "host": ["{{baseUrl}}"],
          "path": ["api", "equipaje", "123", "ruta"]
        }
      }
    }
  ]
}

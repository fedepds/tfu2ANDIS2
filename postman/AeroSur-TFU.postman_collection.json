      "key": "app2Url",
      "value": "http://localhost:3002"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "tokenOperador",
      "value": ""
    },
    {
      "key": "tokenSupervisor",
      "value": ""

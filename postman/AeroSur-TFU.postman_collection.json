              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 en operación normal', () => pm.response.to.have.status(200));",
                  "const inst = pm.response.headers.get('X-Instancias-Probadas') || '';",
                  "const est = pm.response.headers.get('X-Estados') || '';",
